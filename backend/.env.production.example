# ─────────────────────────────────────────────────────────────────────────────
# Production environment variables template
# Copy → .env.production and fill in real values.
# .env.production is gitignored — set these in Render dashboard env vars.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=production

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Use the SESSION pooler string from Supabase → Connect (IPv4, port 5432), not the direct db.* host.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<SUPABASE_DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# ── Redis (optional — leave unset to disable caching and rate limiting) ──────
# REDIS_URL=rediss://default:<UPSTASH_PASSWORD>@<YOUR_UPSTASH_HOST>:6379

# ── Auth / JWT ────────────────────────────────────────────────────────────────
SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_hex(32))">
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Google / Gemini AI ────────────────────────────────────────────────────────
GOOGLE_API_KEY=<YOUR_GEMINI_API_KEY>

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_STORAGE_BUCKET=resumes
SUPABASE_STORAGE_BUCKET_PUBLIC=false

# ── Frontend CORS ─────────────────────────────────────────────────────────────
FRONTEND_URL=https://<YOUR_VERCEL_URL>.vercel.app

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=

# ── ATS ───────────────────────────────────────────────────────────────────────
ATS_SCORE_THRESHOLD=65
